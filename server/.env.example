PORT=5000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-url>/<db-name>
JWT_SECRET=replace-with-a-long-random-string

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# M-Pesa Daraja — mock needs nothing below; sandbox/production need real
# credentials from the Safaricom Daraja developer portal, plus a publicly
# reachable MPESA_CALLBACK_URL (e.g. via ngrok in local dev).
MPESA_MODE=mock
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# KRA eTIMS — mock needs nothing below. Live mode is not implemented; wiring
# it up requires verifying current KRA OSCU/VSCU developer documentation
# first (kra.go.ke), plus the business's OSCU/VSCU registration.
ETIMS_MODE=mock

# Sentry error tracking. Leave blank to disable — no-ops cleanly with no DSN.
SENTRY_DSN=
