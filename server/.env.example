PORT=5000
NODE_ENV=development
# Number of reverse-proxy hops in front of the app (usually 1 on Railway,
# Render, Heroku, Nginx). Leave unset only if the app is exposed directly.
TRUST_PROXY=
# Effective discount (%) above which a cashier needs an admin's approval PIN.
DISCOUNT_APPROVAL_THRESHOLD=20
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-url>/<db-name>
JWT_SECRET=replace-with-a-long-random-string

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# M-Pesa Daraja — mock needs nothing below; sandbox/production need real
# credentials from the Safaricom Daraja developer portal, plus a publicly
# reachable MPESA_CALLBACK_URL (e.g. via ngrok in local dev).
MPESA_MODE=mock
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Base callback URL, e.g. https://api.example.com/api/payments/mpesa/callback
# — the server appends /<MPESA_CALLBACK_TOKEN> itself.
MPESA_CALLBACK_URL=
# Required outside mock mode: a long random secret, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MPESA_CALLBACK_TOKEN=
# Reversals (refunding a customer charged for a sale that couldn't complete).
# Base URL; the server appends /<MPESA_CALLBACK_TOKEN>.
MPESA_REVERSAL_RESULT_URL=
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=

# KRA eTIMS — mock | live. Live posts to your OSCU/VSCU endpoint; verify the
# payload mapping in services/etims.js against KRA's current spec and your
# sandbox before switching (see docs/GO-LIVE.md). Values come from your
# OSCU/VSCU registration.
ETIMS_MODE=mock
ETIMS_BASE_URL=
ETIMS_TIN=
ETIMS_BRANCH_ID=00
ETIMS_CMC_KEY=
ETIMS_TRADE_NAME=
# Standard-rated VAT band and rate, and the item classification code used
# for every line unless a product overrides it.
ETIMS_DEFAULT_TAX_TYPE=B
ETIMS_DEFAULT_TAX_RATE=16
ETIMS_DEFAULT_ITEM_CLASS=5310000000

# Weekly owner summary (Mondays ~08:00 Nairobi): comma-separated phones to
# text it to. Admin push notifications get it too. Leave blank for push only.
OWNER_SUMMARY_PHONES=

# Business name used in SMS receipts and codes.
BUSINESS_NAME=Wanguvibe

# SMS via Africa's Talking — mock | live. Mock sends nothing. For testing
# against AT's simulator set AT_USERNAME=sandbox with your sandbox API key.
SMS_MODE=mock
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Sentry error tracking. Leave blank to disable — no-ops cleanly with no DSN.
SENTRY_DSN=

# Web Push (browser notifications to admins for shift discrepancies, eTIMS
# retry backlog, low stock). Self-generated keypair, not a third-party
# credential — generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# Leave blank to disable — no-ops cleanly with no VAPID key, same as Sentry above.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
